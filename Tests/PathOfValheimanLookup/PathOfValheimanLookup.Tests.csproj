<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CorePath Condition="'$(CorePath)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim/BepInEx/core</CorePath>
    <GameManaged Condition="'$(GameManaged)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim/valheim_Data/Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;Stubs.cs" />
    <Compile Include="../../Modules/PathOfValheimanLookup/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Reference Include="assembly_valheim"><HintPath>$(GameManaged)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(GameManaged)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(CorePath)/0Harmony.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(CorePath)/Mono.Cecil.dll</HintPath></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(CorePath)/MonoMod.Utils.dll</HintPath></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(CorePath)/MonoMod.RuntimeDetour.dll</HintPath></Reference>
  </ItemGroup>
</Project>
