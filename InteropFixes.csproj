<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="environment.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>InteropFixes</AssemblyName>
    <RootNamespace>InteropFixes</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Unity's framework/standard facade references match Blasted's original-DLL build. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <DeployPath Condition="'$(DeployPath)' == ''">$(ValheimGamePath)\BepInEx\plugins</DeployPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="InteropFixesPlugin.cs;ModuleIsolation.cs;Properties\AssemblyInfo.cs;Modules\**\*.cs" />
    <Reference Include="assembly_valheim"><HintPath>$(CorlibPath)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(CorlibPath)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(CorlibPath)\assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(CorlibPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(CorlibPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(CorlibPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(CorlibPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(CorlibPath)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(CorlibPath)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <!-- Match BepInEx's HarmonyX API without its net35 Emit type forwarding mismatch. -->
    <PackageReference Include="HarmonyX" Version="2.9.0" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="DeployFinalDebugPlugin" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(DeployToGame)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(DeployPath)\$(TargetFileName)" />
    <Message Importance="High" Text="Deployed final Debug DLL: $(DeployPath)\$(TargetFileName)" />
  </Target>
    <Target Name="GetAssemblyVersion">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="PackageAssemblyIdentity"/>
        </GetAssemblyIdentity>
        <ItemGroup>
            <PackageAssemblyVersions Include="@(PackageAssemblyIdentity->'%(Version)')"/>
        </ItemGroup>
        <Error Text="Failed to get the InteropFixes assembly version." Condition="'%(PackageAssemblyVersions.Identity)' == ''"/>
        <PropertyGroup>
            <PackageAssemblyVersion>%(PackageAssemblyVersions.Identity)</PackageAssemblyVersion>
            <PackageMajor>$(PackageAssemblyVersion.Split('.')[0])</PackageMajor>
            <PackageMinor>$(PackageAssemblyVersion.Split('.')[1])</PackageMinor>
            <PackagePatch>$(PackageAssemblyVersion.Split('.')[2])</PackagePatch>
            <PackageVersion>$(PackageMajor).$(PackageMinor).$(PackagePatch)</PackageVersion>
            <PackageName>$(AssemblyName)_v$(PackageVersion)</PackageName>
            <ThunderstorePackageRoot>$(ProjectDir)Thunderstore</ThunderstorePackageRoot>
            <ThunderstoreStagingDir>$(IntermediateOutputPath)Thunderstore\$(PackageName)</ThunderstoreStagingDir>
        </PropertyGroup>
    </Target>
    <Target
        Name="UpdateManifestVersion"
        DependsOnTargets="GetAssemblyVersion"
        Condition=" ('$(Configuration)|$(Platform)' == 'Release|AnyCPU') And ('$(OS)' == 'Windows_NT') ">
        <Error Text="manifest.json not found in Thunderstore directory." Condition="!Exists('$(ThunderstorePackageRoot)\manifest.json')"/>
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateManifest.ps1&quot; -manifestFile &quot;$(ThunderstorePackageRoot)\manifest.json&quot; -versionString &quot;$(PackageVersion)&quot;"/>
    </Target>
    <Target
        Name="MakeThunderstorePackage"
        AfterTargets="Build"
        DependsOnTargets="GetAssemblyVersion;UpdateManifestVersion"
        Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <Error Text="InteropFixes.dll not found in the Release output directory." Condition="!Exists('$(TargetPath)')"/>
        <Error Text="README.md not found in the project root." Condition="!Exists('$(ProjectDir)README.md')"/>
        <Error Text="CHANGELOG.md not found in the Thunderstore directory." Condition="!Exists('$(ThunderstorePackageRoot)\CHANGELOG.md')"/>
        <Error Text="manifest.json not found in the Thunderstore directory." Condition="!Exists('$(ThunderstorePackageRoot)\manifest.json')"/>
        <Error Text="icon.png not found in the Thunderstore directory. Thunderstore requires a 256x256 PNG." Condition="!Exists('$(ThunderstorePackageRoot)\icon.png')"/>
        <ItemGroup>
            <ThunderstorePackageFiles Include="$(TargetPath)"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)README.md"/>
            <ThunderstorePackageFiles Include="$(ThunderstorePackageRoot)\CHANGELOG.md"/>
            <ThunderstorePackageFiles Include="$(ThunderstorePackageRoot)\manifest.json"/>
            <ThunderstorePackageFiles Include="$(ThunderstorePackageRoot)\icon.png"/>
        </ItemGroup>
        <RemoveDir Directories="$(ThunderstoreStagingDir)" Condition="Exists('$(ThunderstoreStagingDir)')"/>
        <MakeDir Directories="$(ThunderstoreStagingDir)"/>
        <Copy SourceFiles="@(ThunderstorePackageFiles)" DestinationFolder="$(ThunderstoreStagingDir)"/>
        <ZipDirectory
            SourceDirectory="$(ThunderstoreStagingDir)"
            DestinationFile="$(ThunderstorePackageRoot)\$(PackageName).zip"
            Overwrite="true"/>
        <RemoveDir Directories="$(ThunderstoreStagingDir)"/>
    </Target>
</Project>
